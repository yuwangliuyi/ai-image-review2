# 仅模板；复制为 .env 后设为 600，真实文件不能进入 Git 或镜像。
# 本地 npm run dev 使用 3003。必须先准备独立数据库副本并执行受控迁移。
DATABASE_URL=file:/absolute/path/to/isolated/validation.db
NEXTAUTH_URL=http://localhost:3003
NEXTAUTH_SECRET=
AUTH_COOKIE_PREFIX=ai-review-sso90-local
AI_REVIEW_INSTANCE_MODE=validation
JX_SSO_ONBOARDING_MODE=guided
JX_SSO_ENVIRONMENT=test
JX_SSO_WEB_URL=https://sso.example.com
JX_SSO_API_URL=https://sso.example.com/sso
# 在 SSO 中登记应用后填写对应的应用标识。
JX_SSO_APP_ID=
# 后续服务器 Compose 参数，部署前确认端口未占用。
AI_REVIEW_PREVIEW_PORT=28001
AI_REVIEW_PREVIEW_IMAGE=ai-image-review-sso90-preview:replace-with-verified-version
AI_REVIEW_PREVIEW_ENV_FILE=../.env
AI_REVIEW_BIND_ADDRESS=127.0.0.1
